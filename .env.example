# Copy to .env (never commit .env). See README.md for advanced optional variables.

# --- 1. Authentication (required) --------------------------------------------
# Generate your Argon2id password hash (single-quoted so `$` is not interpolated):
#   docker run --rm -it ghcr.io/krewos/krewos:latest /usr/local/bin/krewos --hash-password
# KREWOS_AUTH_USERNAME=owner
KREWOS_AUTH_PASSWORD_HASH=
# Exact browser origin (https://krewos.localhost for Docker Compose; http://127.0.0.1:3000 for local `cargo run`):
KREWOS_AUTH_ORIGIN=https://krewos.localhost

# --- 2. LLM Provider — BYOK (required for turns) -----------------------------
# Base URL with `/v1` or `/v1beta`, no trailing slash (e.g. https://api.openai.com/v1,
# https://openrouter.ai/api/v1, or https://generativelanguage.googleapis.com/v1beta):
KREWOS_LLM_BASE_URL=
KREWOS_LLM_API_KEY=
# KREWOS_LLM_MODEL=gpt-6-luna
# Wire protocol: chat_completions (default) | responses | gemini
# KREWOS_LLM_WIRE_API=chat_completions
# KREWOS_LLM_REASONING_EFFORT=

# --- 3. Optional MCP Credentials ---------------------------------------------
# Referenced by `brave_search` in mcp.json (`${env:BRAVE_API_KEY}`):
# BRAVE_API_KEY=
